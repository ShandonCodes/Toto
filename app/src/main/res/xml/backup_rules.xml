<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and lower. Unused while minSdk is 35+, but mirrors
   data_extraction_rules.xml so secrets stay out of cloud backup if minSdk is ever lowered.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="totp_database" />
    <exclude domain="database" path="totp_database-shm" />
    <exclude domain="database" path="totp_database-wal" />
    <exclude domain="database" path="totp_database-journal" />
</full-backup-content>
